# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{yml,yaml,json,toml,cff}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
max_line_length = 80

[Makefile]
# Recipe lines must start with a real tab.
indent_style = tab

[*.aa]
# ASCII art — leading and trailing whitespace is the picture.
trim_trailing_whitespace = false
insert_final_newline = false
